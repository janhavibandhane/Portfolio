# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# SMTP account the contact form sends from. Defaults suit Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# Gmail: an app password (Google Account > Security > 2-Step Verification > App passwords),
# not your normal password.
SMTP_PASS=

# Inbox that receives the messages. Leave empty to use SMTP_USER.
CONTACT_TO=
